---
import { SITE_CONTENT } from "../config";
import { Image } from "astro:assets";

type Props = {
    author: string;
    socialLinks: { text: string; href: string }[];
};

const { author, socialLinks } = Astro.props;
const { email } = SITE_CONTENT.hero;
const year = new Date().getFullYear();
---

<section
    id="contact"
    class="w-full h-screen flex flex-col bg-sky-700 items-center justify-center text-white gap-6 space-between"
>
    <div
        class="w-3/4 flex flex-col-reverse md:flex-row bg-blue-950 rounded-4xl p-10 md:p-20 shadow-2xl/30"
    >
        <div class="flex flex-col flex-1 justify-center">
            <h2 class="mb-6 text-4xl font-bold max-sm:text-center">Get In Touch</h2>
            <p class="text-lg max-sm:text-center">
                Hi there! If you would like to collaborate please <a
                    href={`mailto:${email}`}
                    class="text-amber-600 hover:text-white/80"
                >
                    drop me an email</a
                > or connect with me on
                <a
                    href={`https://linkedin.com/in/ashsahu`}
                    class="text-amber-600 hover:text-white/80">LinkedIn.</a
                >
            </p>
        </div>
        <div class="flex items-center justify-center">
            <Image
                src="/contact.svg"
                alt="Contact Illustration"
                width={300}
                height={300}
                class="max-w-full h-auto"
            />
        </div>
    </div>
    <footer class="absolute bottom-2 flex end text-center text-[10px] text-white/70">
        <p>
            &copy; {year}
            {author}. Built with Astro and Tailwind CSS
        </p>
    </footer>
</section>
