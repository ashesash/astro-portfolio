---
import { SITE_CONTENT } from "../config";

type Props = {
    author: string;
    socialLinks: { text: string; href: string }[];
};

const { author, socialLinks } = Astro.props;
const { email } = SITE_CONTENT.hero;
const year = new Date().getFullYear();
---

<section
    id="contact"
    class="-z-50 mt-32 h-screen bg-sky-800 pt-16 pb-8 text-white"
>
    <div class="mx-auto max-w-5xl pl-10">
        <div class="flex flex-row bg-indigo-900 py-22 my-20">
            <div class="w-1/2 ml-10">
                <h2 class="mb-6 text-4xl font-bold">Get In Touch</h2>
                <p class="text-lg">
                    Hi there! If you would like to collaborate please <a
                        href={`mailto:${email}`}
                        class="text-amber-600 hover:text-white/80"
                    >
                        drop me an email</a
                    > or connect with me on social media.
                </p>
            </div>
            <div class="w-1/2 flex items-center justify-center">
                <!-- svg char -->
            </div>
        </div>
    </div>
    <div class=" text-center text-sm text-white/70">
        <p>&copy; {year} {author}. All rights reserved.</p>
        <p class="mt-1">Built with Astro and Tailwind CSS</p>
    </div>
</section>
