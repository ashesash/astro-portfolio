---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "../types";

interface Props {
    projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects" id="projects">
    {
        projects.map(
            ({ name, summary, image, linkPreview, linkSource }, index) => {
                return (
                    <div
                        style={{
                            "--mobile-top": `calc(10vh + ${index * 4}vh)`,
                            "--desktop-top": `calc(3vh + ${index * 4}vh)`,
                        }}
                        class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black top-[var(--mobile-top)] md:top-[var(--desktop-top)]"
                    >
                        <div class="relative z-[1] grid h-[580px] w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:grid-cols-2 sm:grid-rows-1 md:h-96">
                            <div class="px-6 pt-12">
                                <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                                    {name}
                                </h3>
                                <p class="text-base text-neutral">{summary}</p>
                                <div class="flex gap-5 pt-10 text-white">
                                    <a
                                        href={linkSource}
                                        target="_blank"
                                        class="flex items-center gap-1 hover:underline"
                                        rel="noopener noreferrer"
                                    >
                                        Source
                                        <svg
                                            width="12"
                                            height="12"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="4"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M7 17L17 7M17 7H7M17 7V17" />
                                        </svg>
                                    </a>
                                    <a
                                        href={linkPreview}
                                        target="_blank"
                                        class="flex items-center gap-1 hover:underline"
                                        rel="noopener noreferrer"
                                    >
                                        Preview
                                        <svg
                                            width="12"
                                            height="12"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="4"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        >
                                            <path d="M7 17L17 7M17 7H7M17 7V17" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                            <div class="flex items-end justify-end overflow-hidden">
                                <Image
                                    class="h-40 w-56 rounded-ss-xl rounded-ee-2xl object-cover object-left-top sm:h-[85%] sm:w-full"
                                    src={image}
                                    alt={name}
                                    width="224"
                                    height="163"
                                />
                            </div>
                        </div>
                    </div>
                );
            },
        )
    }
</Section>
