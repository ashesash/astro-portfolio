---
interface Props {
    text?: string;
    href?: string;
    id?: string;
    class?: string;
}

const { text, href, id, class: className = "" } = Astro.props;
const sectionId = id || href;
---

<section id={sectionId} class={`py-24 ${className}`}>
    {text && (
        <h2
            class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
        >
            {text}
        </h2>
    )}
    <slot />
</section>
