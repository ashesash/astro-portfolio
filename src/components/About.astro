---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "../types";
// import { Image } from "astro:assets";

type Props = AboutProps & Pick<HeroProps, "name">;

// const { description, image, name } = Astro.props;
const { description } = Astro.props;
const paragraphs = description.split('\n\n').filter(p => p.trim());
---

<Section text="About Me" href="about">
    <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
        <div class="w-auto space-y-4 text-base text-neutral md:pr-5">
            {
                paragraphs.map((paragraph) => (
                    <p>{paragraph.trim()}</p>
                ))
            }
        </div>
        <!-- <div
            class="h-80 w-64 flex-shrink-0 rotate-[5deg] bg-white p-4 md:rotate-[7deg]"
        >
            <Image
                class="object-cover"
                src={image}
                width="260"
                height="260"
                alt={name}
            />
        </div> -->
    </div>
</Section>
