---
import Section from "./Section.astro";
import type { AboutProps, HeroProps } from "../types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description } = Astro.props;
const paragraphs = description.split("\n\n").filter((p) => p.trim());
---

<Section text="About Me" href="about" class="h-screen">
    <div class="z-10 flex flex-col items-center gap-12 md:flex-row md:gap-8">
        <div
            id="about-content"
            class="w-auto space-y-4 text-base text-neutral md:pr-5"
        >
            {paragraphs.map((paragraph) => <p>{paragraph.trim()}</p>)}
        </div>
    </div>
</Section>

<script>
    const aboutContent = document.getElementById("about-content");

    function handleParallax() {
        if (!aboutContent) return;

        const scrolled = window.pageYOffset;
        const rate = scrolled * 0.01;

        aboutContent.style.transform = `translateY(${rate}px)`;
    }

    window.addEventListener("scroll", handleParallax);
</script>
