  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(40px);
    }
  }
  
  .menu-item {
    animation: slideDown 0.5s ease-out forwards;
  }
</style>
